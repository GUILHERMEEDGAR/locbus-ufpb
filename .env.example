# =====================================================================
# LocBUS - Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# =====================================================================

# Configurações do Aplicativo
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Configurações do Broker MQTT (Coletor ESP32 / Telemetria)
MQTT_BROKER=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=tele/#
